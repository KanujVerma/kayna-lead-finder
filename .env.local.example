# Local env for `next dev` / jest. Copy to .env.local (gitignored) and paste real keys.
# .env.local is gitignored — never commit it.
#
# NEXT_PUBLIC_* vars are exposed to the browser.
# The Secret key is server-only — never prefix it NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://qvoxnqlcrmwuvjlkzmcw.supabase.co

# Supabase Dashboard → Project Settings → API → Publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Project Settings → API → Secret key (server-only, never commit):
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Phase 6A — Gmail OAuth (server-only; never prefix these NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Base URL for OAuth redirect URI derivation. Dev: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Google Cloud Console → Credentials → OAuth 2.0 Client IDs → Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM encryption key for stored tokens — 32 random bytes, base64-encoded.
# Generate with: openssl rand -base64 32
# NEVER commit the real value. NEVER share or paste into chat.
GMAIL_TOKEN_ENC_KEY=

# Expected sender account — callback rejects any other Google account.
GMAIL_SENDER_EMAIL=team.kayna@gmail.com
